GROQ_API_KEY=your-groq-api-key-here
# Groq powers the query parser, the evidence summarizer and (by default) the LLM judge.
# Model for the app; confirm account access before any live test.
GROQ_MODEL=openai/gpt-oss-20b
# Optional: OpenRouter, for the LLM judge only (python -m eval.llm_judge --provider openrouter).
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_MODEL=openai/gpt-oss-120b
# Optional: NVIDIA API catalog (build.nvidia.com), for the LLM judge only (--provider nvidia).
NVIDIA_API_KEY=your-nvidia-api-key-here
NVIDIA_MODEL=openai/gpt-oss-120b
