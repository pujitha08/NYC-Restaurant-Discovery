# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Environments / secrets
.venv/
venv/
.env
.env.txt

# Data (large; share via Drive/Hugging Face, not git)
data/*
!data/.gitkeep

# EDA outputs: keep EDA_SUMMARY.md and three key figures; the rest regenerates with
# `python -m src.data.eda`
reports/eda/*.png
reports/eda/*.csv
!reports/eda/words_per_restaurant.png
!reports/eda/review_length.png
!reports/eda/dietary_rate_by_category.png

# Notebooks
.ipynb_checkpoints/

# OS / IDE
.DS_Store
.idea/
.vscode/

# Judging pool and per-system runs: regenerate with `python -m eval.make_pool`
# (runs.csv names the system behind each result; keep it away from the judges)
eval/pool.csv
eval/runs.csv
# LLM judge failures (retried on the next run)
eval/llm_judge_errors.jsonl

# Labels and rater material: judges must not see each other's files, the key files reveal systems or
# versions, and the LLM labels must stay unseen while humans label the same pairs. Share files directly.
# The two labeling guides stay tracked.
eval/labels/*
!eval/labels/LABELING_GUIDE.md
!eval/labels/SENTENCE_LABELING_GUIDE.md
eval/answer_eval/
eval/llm_labels*.jsonl

# App request logs (queries, results, timings; never keys)
logs/
